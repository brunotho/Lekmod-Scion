<!-- LEKMOD (2026-10-28): a banner at the top of the screen for a few seconds for big announcements
     (special City-States, wonders others complete, wars). Lua/LekmodAnnouncementBanner.lua; click it to close it. -->
<Context ColorSet="Beige_Black_Alpha" Font="TwCenMT18" FontStyle="Shadow">
	<Grid Anchor="C,T" Offset="0,96" Size="760,90" Padding="0,0" Style="Grid9DetailFive140" ConsumeMouse="1" ID="Banner" Hidden="1">
		<Button Anchor="C,C" Size="760,90" ID="BannerButton" ToolTip="TXT_KEY_LEKMOD_BANNER_TT">
			<Stack Anchor="C,C" StackGrowth="Bottom" Padding="4" ID="BannerStack">
				<Label Anchor="C,T" Font="TwCenMT24" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" ID="Title"/>
				<Label Anchor="C,T" WrapWidth="700" Font="TwCenMT18" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" ID="Body"/>
			</Stack>
		</Button>
	</Grid>
</Context>
