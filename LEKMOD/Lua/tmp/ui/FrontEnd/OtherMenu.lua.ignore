-------------------------------------------------
-- Script Body
-------------------------------------------------
local bHideUITest = true;
local bHideGridExamples = true;
local bHideLoadGame = true;
local bHidePreGame = true;
local fTime = 0;


function ShowHideHandler( bIsHide, bIsInit )
    if( not bIsHide ) then
        Controls.Civ5Logo:SetTexture( "CivilzationV_Logo.dds" );
        
        Controls.MainMenuScreenUI:SetHide( false );
    else
        Controls.Civ5Logo:UnloadTexture();
    end
end
ContextPtr:SetShowHideHandler( ShowHideHandler );


-------------------------------------------------
-- Civilopedia Button Handler
-------------------------------------------------
Controls.CivilopediaButton:RegisterCallback( Mouse.eLClick, function()
	UIManager:QueuePopup(Controls.Civilopedia, PopupPriority.HallOfFame);
end);


-------------------------------------------------
-- HoF Button Handler
-------------------------------------------------
function HallOfFameClick()
	UIManager:QueuePopup( Controls.HallOfFame, PopupPriority.HallOfFame );
end
Controls.HallOfFameButton:RegisterCallback( Mouse.eLClick, HallOfFameClick );

-------------------------------------------------
-- View Replays Handler
-------------------------------------------------
function ViewReplaysButtonClick()
	UIManager:QueuePopup( Controls.LoadReplayMenu, PopupPriority.HallOfFame );
end
Controls.ViewReplaysButton:RegisterCallback( Mouse.eLClick, ViewReplaysButtonClick );

-------------------------------------------------
-- Credits Button Handler
-------------------------------------------------
function CreditsClicked()
    UIManager:QueuePopup( Controls.Credits, PopupPriority.Credits );
end
Controls.CreditsButton:RegisterCallback( Mouse.eLClick, CreditsClicked );

-------------------------------------------------
-- LEKMOD: Multiplayer: Other Modes (Standard with the online game list, Hot Seat, Pitboss)
-- opens the Multiplayer screen with the base buttons (MultiplayerSelect listens)
-------------------------------------------------
Controls.LekmodMultiplayerModesButton:RegisterCallback( Mouse.eLClick, function()
	UIManager:DequeuePopup( ContextPtr );
	LuaEvents.LekmodOpenMultiplayerOtherModes();
end);

-------------------------------------------------
-- LEKMOD (2026-10-23): DLC, Discord and GitHub moved here from the main menu
-------------------------------------------------
Controls.ExpansionRulesSwitch:RegisterCallback( Mouse.eLClick, function()
	UIManager:QueuePopup( Controls.PremiumContentScreen, PopupPriority.OtherMenu );
end);

-------------------------------------------------
-- Discord / GitHub link buttons
-------------------------------------------------
local LEKMOD_DISCORD_URL = "http://discord.gg/VQBNPmc";
local LEKMOD_GITHUB_URL = "http://github.com/EnormousApplePie/Lekmod";

local function OpenExternalUrl(url)
	-- Force http:// for Steam overlay compatibility.
	local target = tostring(url or "");
	if string.sub(target, 1, 8) == "https://" then
		target = "http://" .. string.sub(target, 9);
	elseif string.sub(target, 1, 7) ~= "http://" then
		target = "http://" .. target;
	end

	local ok = pcall(function()
		Steam.ActivateGameOverlayToWebPage(target);
	end);
	if not ok and LekmodVersion ~= nil and LekmodVersion.OpenDownload ~= nil then
		LekmodVersion.OpenDownload(target);
	end
end

function DiscordClick()
	OpenExternalUrl(LEKMOD_DISCORD_URL);
end
function GitHubClick()
	OpenExternalUrl(LEKMOD_GITHUB_URL);
end

if Controls.DiscordButton ~= nil then
	Controls.DiscordButton:RegisterCallback(Mouse.eLClick, DiscordClick);
	local tip = Locale.Lookup("TXT_KEY_LEKMOD_MENU_DISCORD_TT");
	if tip == nil or tip == "" or tip == "TXT_KEY_LEKMOD_MENU_DISCORD_TT" then
		tip = "Join the Lekmod Discord";
	end
	Controls.DiscordButton:SetToolTipString(tip);
end
if Controls.GitHubButton ~= nil then
	Controls.GitHubButton:RegisterCallback(Mouse.eLClick, GitHubClick);
	local tip = Locale.Lookup("TXT_KEY_LEKMOD_MENU_GITHUB_TT");
	if tip == nil or tip == "" or tip == "TXT_KEY_LEKMOD_MENU_GITHUB_TT" then
		tip = "Open the Lekmod GitHub repository";
	end
	Controls.GitHubButton:SetToolTipString(tip);
end

-------------------------------------------------
-- Back Button Handler
-------------------------------------------------
function BackButtonClick()

    UIManager:DequeuePopup( ContextPtr );

end
Controls.BackButton:RegisterCallback( Mouse.eLClick, BackButtonClick );


----------------------------------------------------------------
-- Input processing
----------------------------------------------------------------
function InputHandler( uiMsg, wParam, lParam )
    if uiMsg == KeyEvents.KeyDown then
        if wParam == Keys.VK_ESCAPE then
            BackButtonClick();
            return true;
        end
    end
end
ContextPtr:SetInputHandler( InputHandler );