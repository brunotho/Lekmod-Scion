<?xml version="1.0" encoding="utf-8"?>
<!-- LEKMOD (2026-11-05, New Specs 10): promotion templates. A small panel above the unit panel for the selected military unit:
     two templates per unit combat type (click = apply, Shift+1 / Shift+2), Auto toggle, delete, "+ New template" opens the builder.
     Lua/LekmodPromotionTemplates.lua; loaded by InGame.lua. Templates live on the player's PC (Modding.OpenUserData). -->
<Context ColorSet="Beige_Black_Alpha" Font="TwCenMT16" FontStyle="Shadow">
	<Instance Name="TemplateIconInstance">
		<Image Anchor="L,C" Size="32,32" ID="Icon"/>
	</Instance>
	<Instance Name="PickInstance">
		<Button Anchor="L,T" Size="45,45" ID="Button">
			<Image Anchor="C,C" Size="45,45" ID="Icon"/>
		</Button>
	</Instance>

	<!-- the panel: a Stack lays out the rows top to bottom with one gap size (Padding 10). The frame has a fixed size:
	     content 316 x 163, plus 24 px left/right and 18 px top/bottom inside the visible border. The frame texture
	     (Grid9DetailSix140, 70 px corners) draws its border about 35 px inside the control's top and bottom edge, so the
	     control is 70 px taller than the visible frame (screenshots 2026-11-05).
	     The Lua places it right above the unit panel's action box (LekmodPTPosition).
	     Opens by itself when the selected unit can pick a promotion and its type has no Auto template; Alt+T or
	     Map Options keep it open. -->
	<Grid Anchor="L,B" Offset="72,345" Size="364,269" Style="Grid9DetailSix140" ConsumeMouse="1" Hidden="1" ID="Panel">
		<Stack Anchor="C,C" StackGrowth="Bottom" Padding="10" ID="PanelStack">
			<Container Anchor="L,T" Size="316,32">
				<Label Anchor="L,C" Font="TwCenMT18" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_LEKMOD_PT_TITLE"/>
				<PullDown Anchor="L,C" Offset="84,0" Size="196,27" Style="GenericPullDown" ScrollThreshold="300" AutoSizePopUp="1" SpaceForScroll="1" ToolTip="TXT_KEY_LEKMOD_PT_TYPE_TT" ID="TypePullDown"/>
				<Button Anchor="R,C" Size="32,32" TextureOffset="32,0" Texture="assets/UI/Art/Notification/CloseMinButtons.dds" ToolTip="TXT_KEY_LEKMOD_PT_CLOSE_TT" ID="CloseButton"/>
			</Container>
			<Container Anchor="L,T" Size="316,18">
				<Label Anchor="L,B" Offset="6,0" Font="TwCenMT14" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_LEKMOD_PT_COL_PROMOTIONS"/>
				<Label Anchor="L,B" Offset="170,0" Font="TwCenMT14" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_LEKMOD_PT_COL_KEY"/>
				<Label Anchor="L,B" Offset="221,0" Font="TwCenMT14" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_LEKMOD_PT_AUTO" ToolTip="TXT_KEY_LEKMOD_PT_AUTO_COL_TT"/>
			</Container>
			<Box Anchor="L,T" Size="316,1" Color="255,255,200,70"/>
			<Container Anchor="L,T" Size="316,36" ID="Row1">
				<GridButton Anchor="L,C" Size="148,36" Style="SmallButton" ID="Apply1">
					<Stack Anchor="L,C" Offset="6,0" StackGrowth="Right" Padding="2" ID="Icons1"/>
					<Label Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black" String="TXT_KEY_LEKMOD_PT_NEW" ID="New1"/>
				</GridButton>
				<!-- hotkey like on the promotion buttons: modifier above, key below -->
				<Container Anchor="L,C" Offset="160,0" Size="40,36" ID="Key1">
					<Label Anchor="C,T" Offset="0,3" Font="TwCenMT14" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_LEKMOD_PT_KEY_MOD"/>
					<Label Anchor="C,B" Offset="0,4" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="1"/>
				</Container>
				<!-- Auto: the circle only shows the state; the invisible button on top takes the clicks (a radio button can't be clicked off) -->
				<Container Anchor="L,C" Offset="214,0" Size="40,36" ID="AutoBox1">
					<RadioButton Anchor="C,C" ButtonTexture="Assets/UI/Art/Controls/CheckBox.dds" IsChecked="0" String="" ID="Auto1"/>
					<Button Anchor="C,C" Size="36,34" ID="AutoClick1"/>
				</Container>
				<!-- delete: the red kick icon of the multiplayer screens, so it doesn't look like the panel's close button -->
				<Button Anchor="L,C" Offset="276,0" Size="24,24" Texture="IconFrame24Delete.DDS" ToolTip="TXT_KEY_LEKMOD_PT_DELETE_TT" ID="Delete1"/>
			</Container>
			<Container Anchor="L,T" Size="316,36" ID="Row2">
				<GridButton Anchor="L,C" Size="148,36" Style="SmallButton" ID="Apply2">
					<Stack Anchor="L,C" Offset="6,0" StackGrowth="Right" Padding="2" ID="Icons2"/>
					<Label Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black" String="TXT_KEY_LEKMOD_PT_NEW" ID="New2"/>
				</GridButton>
				<!-- hotkey like on the promotion buttons: modifier above, key below -->
				<Container Anchor="L,C" Offset="160,0" Size="40,36" ID="Key2">
					<Label Anchor="C,T" Offset="0,3" Font="TwCenMT14" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_LEKMOD_PT_KEY_MOD"/>
					<Label Anchor="C,B" Offset="0,4" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="2"/>
				</Container>
				<!-- Auto: the circle only shows the state; the invisible button on top takes the clicks (a radio button can't be clicked off) -->
				<Container Anchor="L,C" Offset="214,0" Size="40,36" ID="AutoBox2">
					<RadioButton Anchor="C,C" ButtonTexture="Assets/UI/Art/Controls/CheckBox.dds" IsChecked="0" String="" ID="Auto2"/>
					<Button Anchor="C,C" Size="36,34" ID="AutoClick2"/>
				</Container>
				<!-- delete: the red kick icon of the multiplayer screens, so it doesn't look like the panel's close button -->
				<Button Anchor="L,C" Offset="276,0" Size="24,24" Texture="IconFrame24Delete.DDS" ToolTip="TXT_KEY_LEKMOD_PT_DELETE_TT" ID="Delete2"/>
			</Container>
		</Stack>
	</Grid>

	<!-- the template builder -->
	<Box Color="Black.150" Size="Full.Full" ConsumeMouse="1" Hidden="1" ID="Builder">
		<Grid Size="440,420" Anchor="C,C" Padding="0,20" Style="Grid9DetailFive140" ID="BuilderFrame">
			<Box Style="MenuLeftSideTreatment"/>
			<Box Style="MenuRightSideTreatment"/>
			<Label Anchor="C,T" Offset="0,18" Font="TwCenMT22" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" ID="BuilderTitle"/>
			<Label Anchor="C,T" Offset="0,48" WrapWidth="400" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_LEKMOD_PT_BUILDER_HELP" ID="BuilderHelp"/>
			<!-- the chosen sequence: 4 places -->
			<Stack Anchor="C,T" Offset="0,96" StackGrowth="Right" Padding="8" ID="SeqStack">
				<Box Size="49,49" Color="255,255,200,80"><Box Anchor="C,C" Size="47,47" Color="0,0,0,200"><Image Anchor="C,C" Size="45,45" ID="Seq1"/></Box></Box>
				<Box Size="49,49" Color="255,255,200,80"><Box Anchor="C,C" Size="47,47" Color="0,0,0,200"><Image Anchor="C,C" Size="45,45" ID="Seq2"/></Box></Box>
				<Box Size="49,49" Color="255,255,200,80"><Box Anchor="C,C" Size="47,47" Color="0,0,0,200"><Image Anchor="C,C" Size="45,45" ID="Seq3"/></Box></Box>
				<Box Size="49,49" Color="255,255,200,80"><Box Anchor="C,C" Size="47,47" Color="0,0,0,200"><Image Anchor="C,C" Size="45,45" ID="Seq4"/></Box></Box>
			</Stack>
			<!-- the combat type's promotions (placed by the Lua in rows of 8) -->
			<ScrollPanel Anchor="C,T" Offset="0,160" Size="400,190" Vertical="1" ID="PickScroll">
				<Container Anchor="L,T" Size="400,190" ID="PickArea"/>
				<ScrollBar Offset="0,18" Style="VertSlider" Anchor="R,T" AnchorSide="I,I" Length="154" ID="PickScrollBar"/>
				<UpButton Offset="0,0" Style="ScrollBarUp" Anchor="R,T" AnchorSide="I,I" ID="PickScrollUp"/>
				<DownButton Offset="0,0" Style="ScrollBarDown" Anchor="R,B" AnchorSide="I,I" ID="PickScrollDown"/>
			</ScrollPanel>
			<Stack Anchor="C,B" Offset="0,22" StackGrowth="Right" Padding="12">
				<GridButton Style="BaseButton" Size="110,34" ID="UndoButton">
					<Label Anchor="C,C" String="TXT_KEY_LEKMOD_PT_UNDO" ColorSet="Beige_Black" Font="TwCenMT20" FontStyle="Shadow"/>
				</GridButton>
				<GridButton Style="BaseButton" Size="110,34" ID="SaveButton">
					<Label Anchor="C,C" String="TXT_KEY_LEKMOD_PT_SAVE" ColorSet="Beige_Black" Font="TwCenMT20" FontStyle="Shadow"/>
				</GridButton>
				<GridButton Style="BaseButton" Size="110,34" ID="CancelButton">
					<Label Anchor="C,C" String="TXT_KEY_LEKMOD_PT_CANCEL" ColorSet="Beige_Black" Font="TwCenMT20" FontStyle="Shadow"/>
				</GridButton>
			</Stack>
		</Grid>
	</Box>
</Context>
