<button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="sidebar">Sections</button>
<aside class="sidebar" id="sidebar">
  <ul class="sections-nav">
<% groups.each do |group, blocks| -%>
    <li><a href="#<%= slug(group) %>" data-section-link="<%= slug(group) %>"><%= h tag_label(group) %> <span class="count" data-count-for="<%= slug(group) %>"><%= blocks.sum { |bl| bl.cards.size } %></span></a></li>
<% end -%>
  </ul>
<% if essentials_toc && !essentials_toc.empty? -%>
  <ul class="essentials-nav">
<% essentials_toc.each do |id, title| -%>
    <li><a href="#<%= id %>" data-section-link="<%= id %>"><%= h title %></a></li>
<% end -%>
  </ul>
<% end -%>
</aside>
<main class="content" id="changelog">
  <h1>Mod changelog</h1>
<% if releases.empty? -%>
  <p class="empty-note">No version of Lekmod Scion has been released yet.</p>
<% else -%>
  <div class="views" role="tablist" aria-label="Changelog view">
    <button type="button" class="view-tab" role="tab" data-view="full" aria-selected="true">Full changelog</button>
<% if essentials_html -%>
    <button type="button" class="view-tab" role="tab" data-view="essentials" aria-selected="false">Essentials</button>
<% end -%>
    <button type="button" class="view-tab" role="tab" data-view="search" aria-selected="false">Search</button>
  </div>
  <p class="version-note" id="version-note">Lekmod Scion <%= h versions.last[1] %> compared with <%= h versions.first[1] %>.</p>
<% if essentials_html -%>
  <section class="essentials card prose" id="essentials">
    <%= essentials_html %>
  </section>
<% end -%>
  <form class="controls" id="controls" onsubmit="return false">
    <div class="versions">
      <label>From
        <select name="from" id="from">
<% versions[0...-1].each_with_index do |(value, label), i| -%>
          <option value="<%= value %>"<%= ' selected' if i == versions.size - 2 %>><%= h label %></option>
<% end -%>
        </select>
      </label>
      <label>to
        <select name="to" id="to">
<% versions[1..].each_with_index do |(value, label), i| -%>
          <option value="<%= value %>"<%= ' selected' if i == versions.size - 2 %>><%= h label %></option>
<% end -%>
        </select>
      </label>
    </div>
    <input type="search" id="search" placeholder="Search the changelog" aria-label="Search the changelog">
    <div class="tags" id="tags">
<% all_tags.each do |tag| -%>
      <button type="button" class="tag" data-tag="<%= h tag %>" aria-pressed="false"><%= h tag_label(tag) %></button>
<% end -%>
    </div>
    <button type="button" class="clear" id="clear" hidden>Clear filters</button>
  </form>
  <p class="empty-note" id="no-results" hidden>Nothing matches these filters.</p>
<% groups.each do |group, blocks| -%>
  <section class="group" id="<%= slug(group) %>" data-section="<%= slug(group) %>">
    <h2><%= h tag_label(group) %></h2>
<% blocks.each do |block| -%>
    <div class="subsection<%= ' minor-changes' if block.minor %>">
<% if block.heading -%>
    <h3 class="subsection-heading"><%= h block.heading %></h3>
<% end -%>
<% block.cards.each do |card| -%>
<% tree = card.group == "policies" && policy_trees[card.name] -%>
    <article class="card<%= ' minor' if card.minor %><%= ' has-tree' if tree %>" data-tags="<%= h card.tags.join('|') %>" data-search="<%= h card.search_text %>">
<% if tree -%>
      <div class="card-main">
<% end -%>
      <h3><%= h card.name %><% if card.fresh %> <span class="new-badge">(NEW)</span><% end %></h3>
<% if card.collects -%>
      <p class="collected">Collected here for the overview: each line is a copy from the card named in grey, under <%= card.collects.split(",").map { |s| %(<a href="##{slug(s.strip)}">#{h tag_label(s.strip)}</a>) }.join(", ") %>.</p>
<% end -%>
<% card.entries.each do |entry| -%>
      <div class="entry" data-release="<%= entry.release.index %>">
        <p class="release-label"><%= h entry.release.title %></p>
<% unless entry.summary.to_s.empty? -%>
        <p class="summary"><%= GameText.line_html(entry.summary) %></p>
<% end -%>
<% unless entry.lines.empty? -%>
        <ul class="lines">
<% entry.lines.each do |line| -%>
<% if line[:ref_name] -%>
          <li class="<%= line[:kind].downcase %> ref"><span class="kind"><%= line[:kind] %></span> <span><% if line[:ref_role] %><span class="role"><%= h line[:ref_role] %></span> <% end %><strong><%= h line[:ref_name] %></strong><div class="game-text"><%= GameText.to_html(line[:ref_text]) %></div><% if line[:items] %><ul class="sub"><% line[:items].each do |it| %><li><%= GameText.line_html(it) %></li><% end %></ul><% end %></span></li>
<% next end -%>
          <li class="<%= line[:kind].downcase %>"><% unless line[:kind] == "Now" %><span class="kind"><%= line[:kind] %></span> <% end %><span><% source, text = Changelog.split_source(line[:text]) %><% if source %><span class="source"><%= h source %></span> <% end %><%= GameText.line_html(text) %><% if line[:items] %><ul class="sub"><% line[:items].each do |it| %><li><%= GameText.line_html(it) %></li><% end %></ul><% end %></span></li>
<% end -%>
        </ul>
<% end -%>
      </div>
<% end -%>
<% if tree -%>
      </div>
      <%= policy_tree_html(tree) %>
<% end -%>
    </article>
<% end -%>
    </div>
<% end -%>
  </section>
<% end -%>
<% end -%>
</main>
